---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="space-y-4">
  {items.map((item, idx) => (
    <details class="group bg-surface-card border border-primary-container/15 rounded-xl p-5 sm:p-6 transition-all duration-200 open:border-primary/40 open:bg-surface-elevated">
      <summary class="flex items-center justify-between cursor-pointer list-none select-none">
        <span class="font-serif text-lg sm:text-xl text-on-surface group-hover:text-primary transition-colors pr-4">
          {item.question}
        </span>
        <span class="w-8 h-8 rounded-full bg-primary-container/10 flex items-center justify-center text-primary shrink-0 transition-transform duration-200 group-open:rotate-180">
          <span class="material-symbols-outlined text-[20px]">expand_more</span>
        </span>
      </summary>
      <div class="pt-4 mt-4 border-t border-primary-container/10 text-sm sm:text-base text-on-surface-variant leading-relaxed">
        {item.answer}
      </div>
    </details>
  ))}
</div>
