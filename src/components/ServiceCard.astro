---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  tags?: string[];
  badge?: string;
  featured?: boolean;
}

const {
  title,
  description,
  href,
  icon,
  tags = [],
  badge,
  featured = false,
} = Astro.props;
---

<div
  class={`relative flex flex-col justify-between p-6 sm:p-8 rounded-2xl border transition-all duration-300 group bg-surface-card hover:border-primary/40 hover:shadow-solar hover:-translate-y-1 ${
    featured
      ? 'border-primary-container/30 bg-gradient-to-b from-surface-card to-surface-elevated'
      : 'border-primary-container/15'
  }`}
>
  <div>
    <!-- Icon & Badge Header -->
    <div class="flex items-center justify-between mb-6">
      <div class="w-12 h-12 rounded-xl bg-primary-container/15 border border-primary-container/25 flex items-center justify-center text-primary group-hover:scale-110 group-hover:bg-primary-container/25 transition-all shadow-sm">
        <span class="material-symbols-outlined text-[24px]">{icon}</span>
      </div>
      {badge && (
        <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-primary-container/20 border border-primary-container/30 text-primary">
          {badge}
        </span>
      )}
    </div>

    <!-- Title & Description -->
    <h3 class="font-serif text-2xl sm:text-[26px] text-on-surface font-normal group-hover:text-primary transition-colors mb-3 leading-snug">
      <a href={href} class="focus:outline-none">
        {title}
      </a>
    </h3>
    <p class="font-sans text-sm sm:text-base text-on-surface-variant leading-relaxed mb-6">
      {description}
    </p>

    <!-- Tag Pills -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-6">
        {tags.map((tag) => (
          <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-surface-elevated text-on-surface-variant/90 border border-primary-container/10">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Bottom Link -->
  <div class="pt-4 border-t border-primary-container/10">
    <a
      href={href}
      class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-primary group-hover:text-amber transition-colors"
    >
      <span>Explore Capability</span>
      <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">
        arrow_forward
      </span>
    </a>
  </div>
</div>
