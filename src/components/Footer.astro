---
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-surface-container-lowest border-t border-primary-container/15 relative z-10 pt-16 pb-12">
  <div class="max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-16 border-b border-primary-container/10">
      <!-- Col 1: Brand & Ethos (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-primary-container/15 border border-primary-container/30 flex items-center justify-center text-primary-container">
            <svg class="w-4 h-4" viewBox="0 0 32 32" fill="none">
              <circle cx="16" cy="16" r="6" fill="#F5A623"/>
              <path d="M16 4V8M16 24V28M4 16H8M24 16H28" stroke="#F5A623" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="font-serif text-lg tracking-wider text-on-surface font-semibold">
            STUDIO RAVYA
          </span>
        </div>
        <p class="font-sans text-sm text-on-surface-variant leading-relaxed max-w-sm">
          A bespoke digital product and web engineering studio. We partner with ambitious founders, creators, and brands to build flagship-grade websites that accelerate real growth.
        </p>
        <div class="pt-2">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container border border-primary-container/20 text-xs font-medium text-primary">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Currently taking Q2/Q3 partnerships
          </span>
        </div>
      </div>

      <!-- Col 2: Services (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-sans text-xs font-bold uppercase tracking-widest text-primary">
          Capabilities
        </h4>
        <ul class="space-y-2 text-sm text-on-surface-variant">
          <li>
            <a href="/services/website-design-development" class="hover:text-primary transition-colors">
              Website Design & Dev
            </a>
          </li>
          <li>
            <a href="/services/landing-pages" class="hover:text-primary transition-colors">
              Landing Pages & Campaigns
            </a>
          </li>
          <li>
            <a href="/services/ecommerce-websites" class="hover:text-primary transition-colors">
              E-commerce Websites
            </a>
          </li>
          <li>
            <a href="/services/brand-and-web-identity" class="hover:text-primary transition-colors">
              Brand & Web Identity
            </a>
          </li>
          <li>
            <a href="/services/custom-web-apps" class="hover:text-primary transition-colors">
              Custom Web Apps & Tools
            </a>
          </li>
          <li class="pt-1">
            <a href="/services" class="text-primary hover:underline text-xs font-semibold inline-flex items-center gap-1">
              Explore Services Hub <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Studio & Navigation (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="font-sans text-xs font-bold uppercase tracking-widest text-primary">
          Studio
        </h4>
        <ul class="space-y-2 text-sm text-on-surface-variant">
          <li><a href="/work" class="hover:text-primary transition-colors">Selected Work</a></li>
          <li><a href="/process" class="hover:text-primary transition-colors">Our Process</a></li>
          <li><a href="/pricing" class="hover:text-primary transition-colors">Pricing & Scope</a></li>
          <li><a href="/blog" class="hover:text-primary transition-colors">Insights & Blog</a></li>
          <li><a href="/about" class="hover:text-primary transition-colors">About the Studio</a></li>
          <li><a href="/faq" class="hover:text-primary transition-colors">Common FAQs</a></li>
        </ul>
      </div>

      <!-- Col 4: Inquiries & Start (3 cols) -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="font-sans text-xs font-bold uppercase tracking-widest text-primary">
          Start a Project
        </h4>
        <p class="font-sans text-sm text-on-surface-variant leading-relaxed">
          Ready to build something exceptional? Tell us what you're working on and get a detailed proposal.
        </p>
        <div>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-primary-container text-charcoal font-sans text-xs font-bold uppercase tracking-wider px-4 py-2.5 rounded-lg shadow-gold-glow hover:bg-amber transition-all"
          >
            <span>Start a Project</span>
            <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
          </a>
        </div>
        <div class="pt-1 text-xs text-on-surface-variant">
          <p>Direct Correspondence:</p>
          <a href="mailto:contact@studioravya.com" class="font-mono text-primary hover:underline">
            contact@studioravya.com
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom copyright bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-outline">
      <p>© {currentYear} Studio Ravya. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/privacy-policy" class="hover:text-on-surface transition-colors">Privacy Policy</a>
        <a href="/terms-of-service" class="hover:text-on-surface transition-colors">Terms of Service</a>
        <a href="/admin/login" class="hover:text-primary transition-colors">CMS Admin</a>
      </div>
    </div>
  </div>
</footer>
