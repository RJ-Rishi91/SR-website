---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Settings | Studio Ravya CMS"
  description="Manage environment configurations, API integrations, and webhook triggers."
  noindex={true}
>
  <div class="max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- CMS Top Bar Navigation -->
    <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 mb-8 border-b border-primary-container/15 gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-primary-container/15 border border-primary-container/30 flex items-center justify-center text-primary">
          <svg class="w-5 h-5" viewBox="0 0 32 32" fill="none">
            <circle cx="16" cy="16" r="6" fill="#F5A623"/>
            <path d="M16 4V8M16 24V28M4 16H8M24 16H28" stroke="#F5A623" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <h1 class="font-serif text-2xl text-on-surface font-semibold tracking-wide">
            Studio CMS Settings
          </h1>
          <p class="text-xs text-outline font-mono">Environment &amp; Webhook Configurations</p>
        </div>
      </div>

      <!-- Admin Nav Links -->
      <nav class="flex flex-wrap items-center gap-2 sm:gap-4 text-xs font-semibold uppercase tracking-wider">
        <a href="/admin/posts/" class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-elevated transition-colors">
          Dispatches
        </a>
        <a href="/admin/editor/" class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-elevated transition-colors">
          Editor
        </a>
        <a href="/admin/inquiries/" class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-elevated transition-colors">
          Inquiries
        </a>
        <a href="/admin/calendar/" class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-elevated transition-colors">
          Calendar
        </a>
        <a href="/admin/settings/" class="px-3 py-1.5 rounded-lg bg-primary-container/20 text-primary border border-primary-container/30">
          Settings
        </a>
        <button
          type="button"
          id="logout-btn"
          class="px-3 py-1.5 rounded-lg text-error hover:bg-error-container/20 transition-colors cursor-pointer"
        >
          Logout
        </button>
      </nav>
    </div>

    <!-- Settings Content Cards -->
    <div class="max-w-3xl space-y-8">
      <!-- Backend Connection Card -->
      <div class="p-6 sm:p-8 rounded-2xl bg-surface-card border border-primary-container/15 space-y-6">
        <div>
          <h2 class="font-serif text-xl text-on-surface font-semibold mb-1">FastAPI Backend Pipeline</h2>
          <p class="text-xs text-on-surface-variant">Server status and API endpoints.</p>
        </div>

        <div class="space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between p-3 rounded-lg bg-surface-elevated border border-primary-container/10">
            <span class="text-outline">API Base URL</span>
            <span class="text-primary" id="api-url-display">Connecting...</span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-lg bg-surface-elevated border border-primary-container/10">
            <span class="text-outline">Backend Health</span>
            <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-semibold" id="api-health-display">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Checking status...
            </span>
          </div>
        </div>
      </div>

      <!-- GitHub Pages CI/CD Webhook Status -->
      <div class="p-6 sm:p-8 rounded-2xl bg-surface-card border border-primary-container/15 space-y-4">
        <h2 class="font-serif text-xl text-on-surface font-semibold mb-1">GitHub Pages Deployment Hook</h2>
        <p class="text-xs text-on-surface-variant">
          When articles are published via the backend, a GitHub Actions repository_dispatch event is triggered to rebuild and deploy the static site.
        </p>

        <div class="p-4 rounded-xl bg-surface-elevated border border-primary-container/10 text-xs font-mono space-y-2">
          <p class="text-primary font-semibold">Event: repository_dispatch [cms_post_published]</p>
          <p class="text-outline">Workflow: .github/workflows/deploy.yml</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const token = localStorage.getItem('studioravya_admin_token');
  if (!token) {
    window.location.href = '/admin';
  }
  document.getElementById('logout-btn')?.addEventListener('click', () => {
    localStorage.removeItem('studioravya_admin_token');
    window.location.href = '/admin';
  });

  const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
  const API_URL = (window as any).PUBLIC_API_URL || (isLocal ? 'http://localhost:8000' : 'https://studioravya-backend.onrender.com');
  const healthEl = document.getElementById('api-health-display');

  fetch(`${API_URL}/api/health`)
    .then((r) => r.json())
    .then((data) => {
      if (healthEl && data.status === 'ok') {
        healthEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400"></span> Online & Operational';
      }
    })
    .catch(() => {
      if (healthEl) {
        healthEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber"></span> Offline / Ready for local start';
        healthEl.className = 'inline-flex items-center gap-1.5 text-xs text-amber font-semibold';
      }
    });
</script>
