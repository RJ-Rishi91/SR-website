---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Editorial Calendar | Studio Ravya CMS"
  description="Visual publication calendar for upcoming essays, dispatches, and campaign launches."
  noindex={true}
>
  <div class="max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- CMS Top Bar Navigation -->
    <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 mb-8 border-b border-primary-container/15 gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-primary-container/15 border border-primary-container/30 flex items-center justify-center text-primary">
          <svg class="w-5 h-5" viewBox="0 0 32 32" fill="none">
            <circle cx="16" cy="16" r="6" fill="#F5A623"/>
            <path d="M16 4V8M16 24V28M4 16H8M24 16H28" stroke="#F5A623" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <h1 class="font-serif text-2xl text-on-surface font-semibold tracking-wide">
            Editorial Calendar
          </h1>
          <p class="text-xs text-outline font-mono">Publishing Velocity &amp; Queue</p>
        </div>
      </div>

      <!-- Admin Nav Links -->
      <nav class="flex flex-wrap items-center gap-2 sm:gap-4 text-xs font-semibold uppercase tracking-wider">
        <a href="/admin/posts/" class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-elevated transition-colors">
          Dispatches
        </a>
        <a href="/admin/editor/" class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-elevated transition-colors">
          Editor
        </a>
        <a href="/admin/inquiries/" class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-elevated transition-colors">
          Inquiries
        </a>
        <a href="/admin/calendar/" class="px-3 py-1.5 rounded-lg bg-primary-container/20 text-primary border border-primary-container/30">
          Calendar
        </a>
        <a href="/admin/settings/" class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-elevated transition-colors">
          Settings
        </a>
        <button
          type="button"
          id="logout-btn"
          class="px-3 py-1.5 rounded-lg text-error hover:bg-error-container/20 transition-colors cursor-pointer"
        >
          Logout
        </button>
      </nav>
    </div>

    <!-- Calendar Layout -->
    <div class="space-y-6">
      <div class="p-6 rounded-2xl bg-surface-card border border-primary-container/15 flex items-center justify-between">
        <div>
          <h2 class="font-serif text-xl text-on-surface font-semibold">March 2026 Schedule</h2>
          <p class="text-xs text-outline font-mono">1 live post · 0 in queue</p>
        </div>
        <a href="/admin/editor/" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-primary-container text-charcoal text-xs font-bold uppercase tracking-wider shadow-gold-glow hover:bg-amber transition-all">
          <span class="material-symbols-outlined text-[15px]">event</span>
          <span>Schedule New Post</span>
        </a>
      </div>

      <!-- Timeline Entries -->
      <div class="space-y-4">
        <div class="p-6 rounded-2xl bg-surface-card border border-primary-container/15 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex flex-col items-center justify-center font-mono shrink-0">
              <span class="text-[10px] uppercase">Mar</span>
              <span class="text-base font-bold">15</span>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">Published</span>
                <span class="text-xs font-mono text-outline">Pricing &amp; Planning</span>
              </div>
              <h3 class="font-serif text-lg text-on-surface">How Much Does a Website Cost in 2026? A Practical Breakdown</h3>
            </div>
          </div>
          <a href="/blog/how-much-does-a-website-cost/" class="text-xs text-primary hover:underline flex items-center gap-1 font-mono">
            <span>View Live</span> →
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const token = localStorage.getItem('studioravya_admin_token');
  if (!token) {
    window.location.href = '/admin';
  }
  document.getElementById('logout-btn')?.addEventListener('click', () => {
    localStorage.removeItem('studioravya_admin_token');
    window.location.href = '/admin';
  });
</script>
