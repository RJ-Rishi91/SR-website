---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | 404"
  description="The page you were looking for could not be found. Navigate back to Studio Ravya home or explore our services."
  noindex={true}
>
  <div class="min-h-[70vh] flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
    <!-- Ambient Solar Orbit Background -->
    <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-primary-container/10 rounded-full blur-[120px]"></div>

    <div class="max-w-xl mx-auto space-y-6 relative z-10">
      <!-- 404 Visual Glyph -->
      <div class="relative w-28 h-28 mx-auto flex items-center justify-center">
        <div class="absolute inset-0 rounded-full border border-primary-container/30 animate-spin" style="animation-duration: 20s;"></div>
        <div class="w-16 h-16 rounded-full bg-primary-container/20 border border-primary-container/40 flex items-center justify-center text-primary shadow-solar">
          <span class="font-serif text-3xl font-light">404</span>
        </div>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl text-on-surface font-normal">
        Out of orbit<span class="text-primary font-serif">.</span>
      </h1>

      <p class="font-sans text-base text-on-surface-variant font-light leading-relaxed max-w-md mx-auto">
        The page you are looking for does not exist, has been moved, or has shifted out of solar alignment.
      </p>

      <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 bg-primary-container text-charcoal font-sans text-xs font-bold uppercase tracking-wider px-6 py-3.5 rounded-lg shadow-gold-glow hover:bg-amber transition-all"
        >
          <span>Return Home</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
        <a
          href="/services/"
          class="inline-flex items-center gap-1.5 px-5 py-3.5 rounded-lg bg-surface-card border border-primary-container/20 text-xs font-semibold text-on-surface hover:text-primary transition-colors"
        >
          <span>Services Hub</span>
        </a>
        <a
          href="/work/"
          class="inline-flex items-center gap-1.5 px-5 py-3.5 rounded-lg bg-surface-card border border-primary-container/20 text-xs font-semibold text-on-surface hover:text-primary transition-colors"
        >
          <span>Selected Work</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
