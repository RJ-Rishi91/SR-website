---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';

const services = [
  {
    title: 'Website Design & Development',
    description: 'Custom, responsive marketing websites built on ultra-fast modern architecture. Designed to establish authority and convert visitors into high-value clients.',
    href: '/services/website-design-development',
    icon: 'web',
    tags: ['Astro / Next.js', 'Bespoke UI/UX', 'SEO Optimization', 'Core Web Vitals 95+'],
    badge: 'Flagship',
  },
  {
    title: 'Landing Pages & Campaigns',
    description: 'High-converting, single-purpose landing pages engineered for product launches, ad campaigns, and venture announcements. Built for speed and conversion rate maximization.',
    href: '/services/landing-pages',
    icon: 'rocket_launch',
    tags: ['Conversion Architecture', 'A/B Testing Ready', 'Fast Turnaround'],
  },
  {
    title: 'E-commerce Websites',
    description: 'Custom digital shopping experiences with bespoke storefronts, tailored checkout flows, and seamless inventory management designed for elevated brand perception.',
    href: '/services/ecommerce-websites',
    icon: 'shopping_bag',
    tags: ['Custom Checkout', 'High AOV Design', 'Payment Gateways'],
  },
  {
    title: 'Brand & Web Identity',
    description: 'Complete visual identity systems, digital typography, chromatic palettes, and comprehensive design tokens that make your business instantly recognizable.',
    href: '/services/brand-and-web-identity',
    icon: 'palette',
    tags: ['Visual Identity', 'Design Systems', 'Digital Guidelines'],
  },
  {
    title: 'Custom Web Apps & Tools',
    description: 'Specialized internal dashboards, client portals, interactive calculators, and full-stack software products built with scalable backend architectures.',
    href: '/services/custom-web-apps',
    icon: 'terminal',
    tags: ['Full-Stack', 'APIs & DBs', 'Custom Business Logic'],
  },
];

const situations = [
  {
    situation: 'Launching a new product or funding announcement in 2–3 weeks',
    recommended: 'Landing Pages & Campaigns',
    href: '/services/landing-pages',
    benefit: 'Fastest time to market with laser-focused conversion architecture.',
  },
  {
    situation: 'Your current website feels outdated, slow, or fails to convert high-ticket leads',
    recommended: 'Website Design & Development',
    href: '/services/website-design-development',
    benefit: 'Full bespoke redesign and engineering to establish category leadership.',
  },
  {
    situation: 'Selling physical or digital goods and standard Shopify templates feel cheap',
    recommended: 'E-commerce Websites',
    href: '/services/ecommerce-websites',
    benefit: 'Tailored luxury catalog UX and streamlined friction-free checkout.',
  },
  {
    situation: 'Starting a new venture or re-platforming without consistent visual guidelines',
    recommended: 'Brand & Web Identity',
    href: '/services/brand-and-web-identity',
    benefit: 'A cohesive visual language across typography, color, and UI components.',
  },
  {
    situation: 'Need custom user accounts, business logic, client portals, or workflow automation',
    recommended: 'Custom Web Apps & Tools',
    href: '/services/custom-web-apps',
    benefit: 'Full-stack software engineering customized to your exact operations.',
  },
];
---

<BaseLayout
  title="Web Design & Development Services"
  description="Explore Studio Ravya's website and web app services — design, development, e-commerce, landing pages, and custom builds. Get a quote for your project."
>
  <!-- Header -->
  <section class="py-20 lg:py-28 relative">
    <div class="max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-4xl">
      <span class="text-xs font-bold uppercase tracking-widest text-primary block mb-3 font-mono">
        Services &amp; Capabilities
      </span>
      <h1 class="font-serif text-4xl sm:text-6xl text-on-surface font-normal leading-tight mb-6">
        Services built around what your <br class="hidden sm:inline"/>
        <span class="italic text-primary">business actually needs</span>
      </h1>
      <p class="font-sans text-lg sm:text-xl text-on-surface-variant font-light max-w-2xl mx-auto leading-relaxed">
        We don't sell bloated packages or cookie-cutter templates. Every engagement is scoped around your real growth objectives and technical requirements.
      </p>
    </div>
  </section>

  <!-- Service Cards Grid -->
  <section class="pb-24 lg:pb-32">
    <div class="max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((svc) => (
          <ServiceCard {...svc} />
        ))}
      </div>
    </div>
  </section>

  <!-- Decision Matrix: Which service fits your situation -->
  <section class="py-24 bg-surface-container-lowest border-y border-primary-container/10">
    <div class="max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-primary block mb-2 font-mono">
          Alignment Guide
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl text-on-surface font-normal">
          Which service fits your situation?
        </h2>
        <p class="font-sans text-sm sm:text-base text-on-surface-variant mt-2">
          Use this simple matrix to identify the right starting point for your scope and budget.
        </p>
      </div>

      <div class="space-y-4">
        {situations.map((item) => (
          <div class="p-6 rounded-xl bg-surface-card border border-primary-container/15 flex flex-col lg:flex-row lg:items-center justify-between gap-4 hover:border-primary/30 transition-all">
            <div class="lg:w-1/2">
              <span class="text-xs text-outline font-mono uppercase block mb-1">If your situation is:</span>
              <p class="font-serif text-lg text-on-surface">{item.situation}</p>
            </div>
            <div class="lg:w-1/3">
              <span class="text-xs text-outline font-mono uppercase block mb-1">Recommended Solution:</span>
              <p class="font-sans text-sm text-primary font-semibold">{item.recommended}</p>
              <p class="text-xs text-on-surface-variant mt-0.5">{item.benefit}</p>
            </div>
            <div>
              <a
                href={item.href}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-surface-elevated hover:bg-primary-container hover:text-charcoal text-xs font-bold uppercase tracking-wider text-primary border border-primary-container/20 transition-all"
              >
                <span>View Details</span>
                <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="py-24 text-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h2 class="font-serif text-3xl sm:text-5xl text-on-surface font-normal">
        Not sure which fits? <br/>
        <span class="italic text-primary">Let's talk it through.</span>
      </h2>
      <p class="font-sans text-sm sm:text-base text-on-surface-variant">
        Send us your raw notes or current site URL. We will provide an honest recommendation on what will move the needle most.
      </p>
      <div class="pt-2">
        <a
          href="/contact"
          class="inline-flex items-center justify-center bg-primary-container text-charcoal font-sans text-sm font-bold uppercase tracking-wider rounded-lg px-8 py-4 shadow-solar hover:bg-amber transition-all"
        >
          Start a Project Discussion
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
