---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thanks — We've Got Your Details | Studio Ravya"
  description="Thank you for reaching out to Studio Ravya. We will review your project requirements and be in touch soon."
  noindex={true}
>
  <div class="min-h-[70vh] flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full text-center space-y-8 bg-surface-card border border-primary-container/20 rounded-3xl p-8 sm:p-12 shadow-solar relative overflow-hidden">
      <!-- Ambient Glow -->
      <div class="pointer-events-none absolute -top-24 -left-24 w-64 h-64 bg-primary-container/15 rounded-full blur-3xl"></div>

      <!-- Icon -->
      <div class="w-16 h-16 rounded-full bg-primary-container/20 border border-primary-container/40 text-primary flex items-center justify-center mx-auto shadow-gold-glow">
        <span class="material-symbols-outlined text-3xl">mark_email_read</span>
      </div>

      <!-- Headline -->
      <div class="space-y-3">
        <h1 class="font-serif text-3xl sm:text-5xl text-on-surface font-normal leading-tight">
          Inquiry received<span class="text-primary font-serif">.</span>
        </h1>
        <p class="font-sans text-base sm:text-lg text-on-surface-variant font-light max-w-lg mx-auto leading-relaxed">
          Thank you for taking the time to share your project details. We have logged your submission and will review it closely.
        </p>
      </div>

      <!-- What to expect timeline box -->
      <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary-container/15 text-left space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-primary font-mono">Next Steps</p>
        <ul class="space-y-2 text-xs sm:text-sm text-on-surface-variant">
          <li class="flex items-start gap-2.5">
            <span class="material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5">schedule</span>
            <span><strong>Turnaround:</strong> You will receive a direct reply from our studio within 24 to 48 hours.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5">call</span>
            <span><strong>Discovery:</strong> If aligned, we will schedule a brief 20-minute call to refine project milestones.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5">description</span>
            <span><strong>Scope &amp; Quote:</strong> We will provide an itemized fixed-scope proposal with clear pricing.</span>
          </li>
        </ul>
      </div>

      <!-- Actions -->
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-primary-container text-charcoal font-sans text-xs font-bold uppercase tracking-wider px-6 py-3.5 rounded-lg shadow-gold-glow hover:bg-amber transition-all"
        >
          <span>Return Home</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
        <a
          href="/work"
          class="w-full sm:w-auto inline-flex items-center justify-center text-xs font-semibold text-primary hover:underline px-6 py-3.5"
        >
          Browse Recent Work
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
