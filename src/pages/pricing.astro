---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingTierCard from '../components/PricingTierCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const tiers = [
  {
    name: 'Landing Page',
    tagline: 'Ideal for product launches, venture funding announcements, and ad campaigns.',
    priceRange: 'Bespoke Proposal',
    timeline: '2 to 3 Weeks',
    features: [
      'Single-page conversion architecture',
      'Bespoke Figma UI/UX design',
      'Mobile-first responsive build',
      'CRM / email webhook integration',
      'A/B split testing readiness',
      'Sub-second edge caching',
      '14-day launch bug warranty',
    ],
  },
  {
    name: 'Flagship Business Website',
    tagline: 'Our most requested service for companies demanding category authority.',
    priceRange: 'Bespoke Proposal',
    timeline: '4 to 6 Weeks',
    popular: true,
    features: [
      '5 to 10 bespoke pages',
      'Complete custom visual system & typography',
      'Technical SEO (Schema.org, OpenGraph)',
      'Sub-second Core Web Vitals (95+ score)',
      'Blog or resource library setup',
      'Bespoke scoping & contact forms',
      'Domain, DNS & SSL cutover',
      '30-day dedicated post-launch support',
    ],
  },
  {
    name: 'Custom E-commerce',
    tagline: 'For luxury lifestyle brands and merchants who need editorial shopping UX.',
    priceRange: 'Bespoke Proposal',
    timeline: '6 to 8 Weeks',
    features: [
      'Bespoke catalog and product lookbooks',
      'Frictionless 1-click checkout flows',
      'Inventory, shipping & tax automation',
      'Stripe, Apple Pay & Google Pay integration',
      'High AOV cross-sell features',
      'Merchant management dashboard training',
      '30-day post-launch warranty',
    ],
  },
  {
    name: 'Custom Web App / MVP',
    tagline: 'For startups and teams requiring authenticated portals, dashboards, or MVPs.',
    priceRange: 'Bespoke Proposal',
    timeline: '8 to 12 Weeks',
    features: [
      'Full-stack Python (FastAPI) & TypeScript build',
      'Role-based authentication & permissions',
      'Interactive data visualization & tables',
      'Custom database design & automated backups',
      'Third-party REST & Webhook APIs',
      'Automated CI/CD deployment pipeline',
      '60-day enterprise stability warranty',
    ],
  },
];

const scopeFactors = [
  { title: 'Page Count & Scope', desc: 'A focused 5-page site requires less surface area than a 25-page library with complex category sorting.', icon: 'layers' },
  { title: 'Custom UI vs. Modified Templates', desc: 'We build bespoke designs tailored to your buyer persona, which commands higher craft than theme modifications.', icon: 'brush' },
  { title: 'Functionality & Logins', desc: 'Adding user accounts, database logic, payment processing, or custom calculations introduces engineering scope.', icon: 'code' },
  { title: 'Content & Copywriting', desc: 'Projects with complete client-provided copy move faster; end-to-end messaging sprints are scoped accordingly.', icon: 'edit_note' },
  { title: 'Urgency & Timeline', desc: 'Compressing a standard 6-week build into 2 weeks requires parallelized studio sprints and dedicated resourcing.', icon: 'bolt' },
];

const scopingFaq = [
  { question: 'How do you scope and quote projects?', answer: 'We work on a fixed-scope model for defined deliverables. Once you submit an inquiry, we analyze your goals and prepare a transparent proposal with milestones, timeline, and exact deliverables before any work begins. No unexpected costs.' },
  { question: 'What is your standard project payment schedule?', answer: 'Standard projects are split into predictable milestones: a deposit upon kickoff to reserve dedicated studio time, and completion upon final approval prior to live deployment.' },
  { question: 'What happens if our requirements evolve mid-project?', answer: 'If you want to add new pages or capabilities after kickoff, we discuss the scope change openly and issue a simple addendum with the adjusted timeline and deliverables.' },
  { question: 'Are there any recurring license fees paid to Studio Ravya?', answer: 'None. Once your site is launched and handed over, you own the code and design 100%. Hosting on platforms like GitHub Pages or Cloudflare Pages is completely free, with zero proprietary lock-ins.' },
];
---

<BaseLayout
  title="Project Scopes & Capabilities | Studio Ravya"
  description="Tailored project scopes for website design, development, and custom web builds. Request a bespoke proposal with clear deliverables and milestones."
>
  <Fragment slot="head">
    <!-- JSON-LD: FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": scopingFaq.map((f) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    })} />

    <!-- JSON-LD: BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://studioravya.onerishi.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Project Scopes",
          "item": "https://studioravya.onerishi.in/pricing/"
        }
      ]
    })} />
  </Fragment>
  <!-- Header -->
  <section class="py-20 lg:py-28 relative">
    <div class="max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="text-xs font-bold uppercase tracking-widest text-primary block mb-3 font-mono">
        Tailored Capabilities
      </span>
      <h1 class="font-serif text-4xl sm:text-6xl text-on-surface font-normal leading-tight mb-6">
        Bespoke digital architecture, <br class="hidden sm:inline"/>
        <span class="italic text-primary">tailored to your vision</span>
      </h1>
      <p class="font-sans text-lg sm:text-xl text-on-surface-variant font-light leading-relaxed">
        Fixed-scope proposals, clear milestones, and complete intellectual property ownership. Tell us what you are building to receive a detailed quote.
      </p>
    </div>
  </section>

  <!-- Pricing Cards Grid -->
  <section class="pb-24 lg:pb-32">
    <div class="max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        {tiers.map((tier) => (
          <PricingTierCard {...tier} />
        ))}
      </div>
    </div>
  </section>

  <!-- What Affects Scope -->
  <section class="py-24 bg-surface-container-lowest border-y border-primary-container/10">
    <div class="max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-primary block mb-2 font-mono">
          Scope Economics
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl text-on-surface font-normal">
          What shapes your project scope
        </h2>
        <p class="font-sans text-sm sm:text-base text-on-surface-variant mt-2">
          Every website scope is driven by concrete project variables:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {scopeFactors.map((item) => (
          <div class="p-6 rounded-2xl bg-surface-card border border-primary-container/15">
            <div class="w-10 h-10 rounded-lg bg-primary-container/15 text-primary flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-[20px]">{item.icon}</span>
            </div>
            <h3 class="font-serif text-xl text-on-surface font-normal mb-2">{item.title}</h3>
            <p class="font-sans text-xs sm:text-sm text-on-surface-variant leading-relaxed">{item.desc}</p>
          </div>
        ))}
        <div class="p-6 rounded-2xl bg-gradient-to-br from-surface-card to-surface-elevated border border-primary-container/30 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-primary block mb-2">Want a straight answer?</span>
            <h3 class="font-serif text-xl text-on-surface font-normal mb-2">Get a Scoped Estimate</h3>
            <p class="font-sans text-xs text-on-surface-variant leading-relaxed">Tell us what you are building and we will reply with a defined scope and timeline.</p>
          </div>
          <div class="pt-4">
            <a href="/contact" class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-primary hover:underline">
              <span>Start Scoping</span>
              <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Scoping FAQ -->
  <section class="py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-primary block mb-2 font-mono">
          Transparency
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl text-on-surface font-normal">
          Frequently Asked Questions About Scoping &amp; Proposals
        </h2>
      </div>
      <FAQAccordion items={scopingFaq} />
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-20 bg-surface-container-lowest border-t border-primary-container/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-serif text-3xl sm:text-4xl text-on-surface font-normal mb-4">
        Ready to build your digital presence?
      </h2>
      <p class="font-sans text-base text-on-surface-variant mb-8 max-w-xl mx-auto">
        Submit your project details through our scoping form. We personally review every submission and deliver a tailored proposal.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 py-4 px-8 rounded-lg bg-primary-container text-charcoal font-sans text-sm font-bold uppercase tracking-wider shadow-gold-glow hover:bg-amber transition-all"
      >
        <span>Request a Tailored Proposal</span>
        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
      </a>
    </div>
  </section>
</BaseLayout>
