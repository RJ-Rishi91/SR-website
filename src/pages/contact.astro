---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Start a Project - Request a Proposal | Studio Ravya"
  description="Tell us about your website or digital product. We review every inquiry personally and reply within 1-2 business days with a tailored roadmap and proposal."
>
  <Fragment slot="head">
    <!-- JSON-LD: ContactPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": "Start a Project - Contact Studio Ravya",
      "description": "Submit your website inquiry or project requirements to Studio Ravya for a custom roadmap and proposal.",
      "url": "https://studioravya.onerishi.in/contact/",
      "mainEntity": {
        "@type": "ProfessionalService",
        "name": "Studio Ravya",
        "email": "contact@studioravya.com",
        "url": "https://studioravya.onerishi.in"
      }
    })} />

    <!-- JSON-LD: BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://studioravya.onerishi.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Contact",
          "item": "https://studioravya.onerishi.in/contact/"
        }
      ]
    })} />
  </Fragment>
  <div class="max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <!-- Header -->
    <header class="max-w-3xl mb-14 lg:mb-16">
      <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-surface-card border border-primary-container/20 shadow-sm mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-sans text-xs uppercase tracking-widest text-primary font-bold">
          Accepting New Client Inquiries
        </span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl text-on-surface font-normal leading-tight mb-4">
        Let's build something <br class="hidden sm:inline"/>
        <span class="italic text-primary">that works</span>.
      </h1>
      <p class="font-sans text-lg sm:text-xl text-on-surface-variant font-light leading-relaxed">
        Whether you need a flagship marketing website, a high-converting landing page, or a custom web app - fill out the scoping inquiry below or write to us directly.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <!-- Left Column: Direct Correspondence & Assurance (5 cols) -->
      <div class="lg:col-span-5 space-y-8">
        <!-- Direct Correspondence Card -->
        <div class="bg-surface-card p-6 sm:p-8 rounded-2xl border border-primary-container/15 shadow-sm space-y-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-primary font-mono block mb-2">
              Direct Correspondence
            </span>
            <div class="flex items-center justify-between gap-3 py-2 border-b border-primary-container/10">
              <a
                href="mailto:contact@studioravya.com"
                class="font-serif text-xl sm:text-2xl text-on-surface hover:text-primary transition-colors tracking-tight break-all font-normal"
              >
                contact@studioravya.com
              </a>
              <button
                type="button"
                id="copy-email-btn"
                class="p-2 rounded-lg text-primary hover:bg-primary-container/15 transition-colors"
                aria-label="Copy email address"
              >
                <span class="material-symbols-outlined text-[20px]" id="copy-icon">content_copy</span>
              </button>
            </div>
            <p class="font-sans text-xs text-primary opacity-0 transition-opacity duration-200 mt-1" id="copy-feedback">
              Copied to clipboard
            </p>
          </div>

          <div class="space-y-3 text-xs text-on-surface-variant">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-[18px]">schedule</span>
              <span>Response time: Usually within 24 to 48 hours</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-[18px]">lock</span>
              <span>Mutual Non-Disclosure Agreement (NDA) available upon request</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-[18px]">verified</span>
              <span>Fixed-price scope proposal with zero obligation</span>
            </div>
          </div>
        </div>

        <!-- What Happens Next Timeline -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface-container-lowest border border-primary-container/15 space-y-4">
          <h3 class="font-serif text-xl text-on-surface font-normal">What happens next</h3>
          <ol class="space-y-4 text-xs sm:text-sm text-on-surface-variant">
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-primary-container/20 text-primary flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">1</span>
              <span><strong>Initial Review:</strong> We examine your website, objectives, and competitive landscape.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-primary-container/20 text-primary flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">2</span>
              <span><strong>Discovery Call:</strong> A focused 30-minute conversation to align on technical scope and milestones.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-primary-container/20 text-primary flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">3</span>
              <span><strong>Tailored Proposal:</strong> A bespoke proposal with defined scope, transparent timeline, and deliverables.</span>
            </li>
          </ol>
        </div>
      </div>

      <!-- Right Column: Interactive Scoping Form (7 cols) -->
      <div class="lg:col-span-7">
        <ContactForm />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyFeedback = document.getElementById('copy-feedback');
  const copyIcon = document.getElementById('copy-icon');

  if (copyBtn && copyFeedback && copyIcon) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('contact@studioravya.com');
        copyFeedback.style.opacity = '1';
        copyIcon.textContent = 'check';
        setTimeout(() => {
          copyFeedback.style.opacity = '0';
          copyIcon.textContent = 'content_copy';
        }, 2500);
      } catch (err) {
        window.location.href = 'mailto:contact@studioravya.com';
      }
    });
  }
</script>
